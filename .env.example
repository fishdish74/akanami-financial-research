# Copy this file to .env. The collector loads it automatically, while an
# already-set process environment variable takes precedence.
# Never commit real secrets.
OPENAI_API_KEY=
MASSIVE_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Required only when the SEC source is enabled. Identify your application/contact.
SEC_USER_AGENT=

MAX_DEEP_ANALYSIS_CALLS=3
MAX_AI_BUDGET_USD=0.25
MIN_CONTENT_CHARS=80

# Real writes remain blocked unless this is explicitly set to 1.
MARKET_COLLECTOR_ENABLE_WRITES=0

# Generated ranking views require this AND the collector write gate to be 1.
# This never grants overwrite permission to research notes.
MARKET_ANALYTICS_ENABLE_RANKING_VIEW_WRITES=0
FORWARD_PAPER_ENABLE_WRITES=0
# Separate event-persistence gate; the release-candidate dry run requires this disabled.
FORWARD_PAPER_EVALUATION_ENABLE_WRITES=0

# Optional pricing overrides used only for approximate cost reporting.
OPENAI_INPUT_COST_PER_MILLION=0.10
OPENAI_OUTPUT_COST_PER_MILLION=0.50
